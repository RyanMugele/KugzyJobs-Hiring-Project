# LOCAL DEVELOPMENT ONLY. Copy to .env and replace the private secret.
SECRET_KEY=replace-with-a-random-private-secret
FLASK_CONFIG=development
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# Public administrator signup is disabled. Run python create_admin.py.
# Payments remain disabled. Email is opt-in; configure all settings before enabling.
# Production settings are provided by render.yaml; see documentation/DEPLOYMENT.md.

# Store real values privately in Render Environment, never in Git.
EMAIL_ENABLED=false
PUBLIC_BASE_URL=https://kugzyjobs.onrender.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=KugzyJobs <noreply@example.com>
